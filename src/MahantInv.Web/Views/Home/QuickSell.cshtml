@{
    ViewData["Title"] = "Quick Sell";
}
<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Quick Sell</h5>
            </div>
            <div class="card-body">
                <div id="quickSellAlert"></div>
                <form id="quickSellForm">
                    <div class="mb-3">
                        <label for="QuickSellProduct" class="form-label">Product</label>
                        <select id="QuickSellProduct" class="form-control" style="width: 100%"></select>
                    </div>
                    <div class="mb-3">
                        <label for="QuickSellQuantity" class="form-label">Quantity</label>
                        <input id="QuickSellQuantity" type="number" min="0.01" step="0.01" class="form-control" placeholder="Enter quantity" />
                    </div>
                    <div class="mb-3">
                        <label for="QuickSellNote" class="form-label">Note <span class="text-muted">(optional)</span></label>
                        <textarea id="QuickSellNote" class="form-control" rows="3" maxlength="1000" placeholder="Add a note (optional)"></textarea>
                    </div>
                    <div class="d-grid d-md-flex justify-content-md-end">
                        <button type="button" id="QuickSellSaveBtn" class="btn btn-success px-4" onclick="Common.QuickSell(this)">
                            <span>Save</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/Home/quicksell.js" type="text/javascript" asp-append-version="true"></script>
}
